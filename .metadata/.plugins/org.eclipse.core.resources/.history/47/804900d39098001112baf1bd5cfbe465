package map;

import java.util.HashMap;
import java.util.Map;

public class GetSizeThenIterate {

	public static void main(String[] args) {
		// Write a Java program to create a method that returns the size of a map and then verifies it by iterating over the map entries.

		HashMap<String,String> s = new HashMap<>();
		s.put("Anubhav", "Raj");
		s.put("Srijan", "Sah");
		
		int a= getSize(s);
		System.out.println("Size is : "+ a);

	}
	
	public static int getSize(Map<String,String> m) {
		return m.size();
	}

}
